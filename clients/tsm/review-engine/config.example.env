# TSM Collision — Review Engine config. Copy to .env and fill in. (.env is gitignored)
SHOP_NAME=TSM Collision

# Twilio (for sending SMS) — get from twilio.com console
TWILIO_ACCOUNT_SID=<your_twilio_sid>
TWILIO_AUTH_TOKEN=<your_twilio_auth_token>
TWILIO_FROM=+1XXXXXXXXXX

# Google review link — from the TSM Google Business Profile (needs Phase-0 GBP access)
# Format: https://search.google.com/local/writereview?placeid=<PLACE_ID>
# (Or use the short g.page/r/...  "review" link Google generates.)
GOOGLE_REVIEW_LINK=<google_review_link>
