<?xml version="1.0" encoding="UTF-8"?>
<!-- Weekly maintenance: rank snapshot + third-party queue overdue check.
     Mondays 9am. Install: cp to ~/Library/LaunchAgents/ then launchctl load -w <path>. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.circuitcoders.saunders.weekly</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-c</string>
    <string>cd /Users/leolebel/clawd/circuit-coders/clients/saunders/machine &amp;&amp; /usr/bin/python3 rank_tracker.py &amp;&amp; /usr/bin/python3 queue_tracker.py check</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>9</integer><key>Minute</key><integer>0</integer></dict>
  <key>StandardOutPath</key><string>/Users/leolebel/clawd/circuit-coders/clients/saunders/machine/data/weekly.log</string>
  <key>StandardErrorPath</key><string>/Users/leolebel/clawd/circuit-coders/clients/saunders/machine/data/weekly.err</string>
</dict>
</plist>
